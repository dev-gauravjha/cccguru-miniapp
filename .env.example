# CCCGuru Telegram Mini App - Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Credentials (Public)
NEXT_PUBLIC_SUPABASE_URL=https://zxzzxtiwlndsghmelnph.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Optional: Used for elevated admin actions / bypass RLS if configured
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot Configuration (SERVER-SIDE ONLY)
# Obtain from @BotFather on Telegram (e.g., 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Public Bot Identity
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=cccgurubot

# Application Public URL (e.g., https://mini.cccguru.in or ngrok https URL for testing)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Development Preview Mode (Set to true to allow in-browser preview without Telegram client)
NEXT_PUBLIC_DEV_PREVIEW=true
